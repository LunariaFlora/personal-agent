{
  "mcpServers": {
    "personal-agent": {
      "command": "<data-dir>/runtime/Scripts/python.exe",
      "args": ["-B", "-m", "personal_agent.mcp_server"],
      "env": {
        "PYTHONPATH": "<path-to-this-repository>",
        "PYTHONIOENCODING": "utf-8",
        "PERSONAL_AGENT_URL": "http://127.0.0.1:8765"
      }
    }
  }
}
